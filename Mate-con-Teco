<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Mate con Teco – Matemáticas básicas para niños</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="App gratuita para que niñas y niños de 6 a 11 años aprendan matemáticas básicas: sumas, restas, tablas de multiplicar, divisiones y quebrados.">
<meta name="theme-color" content="#2F6FEB">
<!-- Ícono incluido en el archivo: es el que se ve al agregar la app a la pantalla de inicio -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Mate con Teco">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<!-- Fuentes opcionales: si no cargan (sin internet), la app usa las fuentes del sistema. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Atkinson+Hyperlegible:wght@400;700&display=swap">
<style>
/* =====================================================================
   ESTILOS
   Concepto de diseño: "cuaderno de colores". Fondo cielo claro, tarjetas
   blancas con borde grueso, botones tipo dulce con sombra inferior que
   se "aplastan" al tocarlos. Una sola columna pensada para el pulgar.
   ===================================================================== */
:root {
  /* --- Colores (tema claro) --- */
  --bg: #EEF5FF;          /* cielo muy claro */
  --surface: #FFFFFF;     /* tarjetas */
  --surface-2: #F6F9FF;   /* zonas internas */
  --ink: #15224A;         /* texto principal (azul tinta) */
  --muted: #4A587D;       /* texto secundario */
  --line: #CFDCF2;        /* bordes */
  --sombra: #B7C8E6;      /* sombra de botones */
  --sun: #FFC53D;         /* amarillo sol: acción principal */
  --sun-dark: #D99A00;
  --coral: #FF6F5B;
  --coral-txt: #C23A26;  /* coral oscuro para textos con buen contraste */
  --mint: #22A86B;
  --sky: #2F6FEB;
  --grape: #6B4BF0;
  --on-color: #15224A;    /* texto sobre fichas de color (igual en ambos temas) */
  /* Fichas de color del menú (claras para que el texto oscuro se lea bien) */
  --t1: #FFD66B; --t2: #8FE3B9; --t3: #9CC8FF; --t4: #FFB3A6; --t5: #C9BBFF; --t6: #D3EE85;
  /* Semáforo (siempre acompañado de ícono y texto) */
  --rojo: #D93A3F;   --rojo-suave: #FFE3E1;
  --amar: #B07A00;   --amar-suave: #FFF1C7;
  --verde: #14824F;  --verde-suave: #D9F6E7;
  --ok: #14824F;     --ok-suave: #D9F6E7;
  --mal: #C2410C;    --mal-suave: #FFE7D6;
  --foco: #6B4BF0;
  --sobre-fuerte: #FFFFFF; /* texto sobre azul o uva fuertes */
  /* --- Tipografía --- */
  --f-titulo: "Fredoka", "Baloo 2", "Trebuchet MS", "Arial Rounded MT Bold", system-ui, sans-serif;
  --f-texto: "Atkinson Hyperlegible", "Segoe UI", Roboto, system-ui, -apple-system, sans-serif;
  /* --- Tamaño de letra ajustable desde Ajustes --- */
  --escala: 1;
  font-size: calc(16px * var(--escala));
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0E1631; --surface: #18234A; --surface-2: #1F2C58; --ink: #F1F4FF; --muted: #B4C0E2;
    --line: #2E3D6E; --sombra: #070D22; --sun: #FFCB4F; --sun-dark: #C48A00; --coral: #FF8A79;
    --mint: #3DD598; --sky: #6FA3FF; --coral-txt: #FF9A8A; --grape: #A08BFF;
    --rojo: #FF7B7F; --rojo-suave: #3E1F33; --amar: #FFD46B; --amar-suave: #3A3220;
    --verde: #5BE3A4; --verde-suave: #173B39; --ok: #5BE3A4; --ok-suave: #173B39;
    --mal: #FFA070; --mal-suave: #40261E; --foco: #C2B3FF; --sobre-fuerte: #0E1631;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0E1631; --surface: #18234A; --surface-2: #1F2C58; --ink: #F1F4FF; --muted: #B4C0E2;
  --line: #2E3D6E; --sombra: #070D22; --sun: #FFCB4F; --sun-dark: #C48A00; --coral: #FF8A79;
  --mint: #3DD598; --sky: #6FA3FF; --coral-txt: #FF9A8A; --grape: #A08BFF;
  --rojo: #FF7B7F; --rojo-suave: #3E1F33; --amar: #FFD46B; --amar-suave: #3A3220;
  --verde: #5BE3A4; --verde-suave: #173B39; --ok: #5BE3A4; --ok-suave: #173B39;
  --mal: #FFA070; --mal-suave: #40261E; --foco: #C2B3FF; --sobre-fuerte: #0E1631;
  color-scheme: dark;
}

/* ---------- Base ---------- */
* { box-sizing: border-box; }
/* Necesario si la app se publica como index.html por su cuenta (GitHub Pages, Netlify) */
[hidden] { display: none !important; }
body {
  margin: 0;
  background: var(--bg); color: var(--ink);
  font-family: var(--f-texto); font-size: 1.05rem; line-height: 1.5;
  -webkit-tap-highlight-color: transparent;
}
/* Franja superior pintada para la zona segura del celular */
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--surface); }
h1, h2, h3 { font-family: var(--f-titulo); line-height: 1.15; text-wrap: balance; margin: 0; font-weight: 700; }
h1 { font-size: 1.75rem; } h2 { font-size: 1.4rem; } h3 { font-size: 1.15rem; }
p { margin: 0; }
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 4px solid var(--foco); outline-offset: 3px; }
.oculto-lector { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.num { font-family: var(--f-titulo); font-variant-numeric: tabular-nums; }

/* ---------- Barra superior ---------- */
.barra {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
  background: var(--surface); border-bottom: 2px solid var(--line);
  padding-left: max(12px, env(safe-area-inset-left, 0px)); padding-right: max(12px, env(safe-area-inset-right, 0px));
  padding-block: 6px;
}
.barra-in { max-width: 560px; margin: 0 auto; display: flex; align-items: center; gap: 6px; }
.barra h1 { font-size: 1.05rem; line-height: 1.1; flex: 1; min-width: 0; } /* títulos largos pasan a dos renglones */
.icono-btn {
  min-width: 48px; min-height: 48px; border-radius: 14px; border: 2px solid var(--line);
  background: var(--surface-2); font-size: 1.35rem; cursor: pointer; display: inline-grid; place-items: center;
}
.icono-btn:active { transform: translateY(2px); }
.chip-estrellas {
  display: inline-flex; align-items: center; gap: 4px; min-height: 48px; padding: 0 12px;
  border-radius: 999px; background: var(--sun); color: var(--on-color); font-family: var(--f-titulo); font-weight: 700; font-size: 1.1rem;
}
.chip-estrellas.pop { animation: pop .5s ease; }

/* ---------- Contenedor principal ---------- */
main {
  max-width: 560px; margin: 0 auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 16px 48px;
  display: flex; flex-direction: column; gap: 16px;
}
main:focus { outline: none; }
.tarjeta { background: var(--surface); border: 2px solid var(--line); border-radius: 22px; padding: 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.sub { color: var(--muted); }
.fila { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
.fila > * { min-width: 0; }

/* ---------- Botones ---------- */
.btn {
  min-height: 56px; padding: 10px 18px; border-radius: 18px; border: 2px solid var(--line);
  background: var(--surface); color: var(--ink); font-family: var(--f-titulo); font-weight: 600; font-size: 1.15rem;
  box-shadow: 0 4px 0 var(--sombra); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  transition: transform .08s, box-shadow .08s; text-align: center;
}
.btn:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--sombra); }
.btn[disabled] { opacity: .45; cursor: not-allowed; }
.btn.primario { background: var(--sun); color: var(--on-color); border-color: var(--sun-dark); box-shadow: 0 4px 0 var(--sun-dark); }
.btn.ancho { width: 100%; }
.btn.chico { min-height: 48px; font-size: 1rem; padding: 6px 14px; }
.btn.peligro { background: var(--rojo-suave); color: var(--rojo); border-color: var(--rojo); box-shadow: 0 4px 0 var(--rojo); }
.dos-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }

/* ---------- Mascota: Teco el tecolote ---------- */
.mascota { display: flex; align-items: flex-end; gap: 10px; }
.buho { font-size: 3.2rem; line-height: 1; flex: none; filter: drop-shadow(0 3px 0 var(--sombra)); }
.buho.salta { animation: salta .6s ease; }
.buho.ladea { animation: ladea .7s ease; }
.globo-texto {
  position: relative; background: var(--surface); border: 2px solid var(--line); border-radius: 18px 18px 18px 4px;
  padding: 10px 14px; font-weight: 700; flex: 1; min-width: 0;
}

/* ---------- Inicio ---------- */
.saludo { display: flex; align-items: center; gap: 12px; }
.avatar-grande { font-size: 2.8rem; width: 72px; height: 72px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--t1); border: 3px solid var(--sun-dark); }
.saludo > div:nth-child(2) { flex: 1; min-width: 0; }
.marcadores { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.marcador { background: var(--surface); border: 2px solid var(--line); border-radius: 18px; padding: 10px 6px; text-align: center; display: flex; flex-direction: column; align-items: center; }
.marcador b { font-family: var(--f-titulo); font-size: 1.6rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
.marcador small { color: var(--muted); font-size: .85rem; line-height: 1.2; }
.menu { display: grid; gap: 12px; }
.ficha {
  display: flex; align-items: center; gap: 14px; min-height: 84px; padding: 12px 16px; border-radius: 22px; border: 0;
  color: var(--on-color); text-align: left; cursor: pointer; box-shadow: 0 5px 0 rgba(21,34,74,.28);
  transition: transform .08s, box-shadow .08s; width: 100%;
}
.ficha:active { transform: translateY(4px); box-shadow: 0 1px 0 rgba(21,34,74,.28); }
.ficha .ico { font-size: 2.4rem; flex: none; width: 52px; text-align: center; }
.ficha b { display: block; font-family: var(--f-titulo); font-size: 1.35rem; line-height: 1.1; }
.ficha span.txt { font-size: .95rem; }
.ficha .txt-c { flex: 1; min-width: 0; }
.aviso { background: var(--amar-suave); border: 2px dashed var(--amar); border-radius: 16px; padding: 10px 14px; font-weight: 700; }
.repaso-teco { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 12px; padding: 12px 14px; border-radius: 22px; background: var(--t6); color: var(--on-color); border: 3px dashed var(--on-color); }
.repaso-teco .ico { font-size: 2.2rem; flex: none; }
.repaso-teco .txt-c { flex: 1 1 170px; min-width: 0; }
.repaso-teco b { display: block; font-family: var(--f-titulo); font-size: 1.25rem; line-height: 1.15; }
.repaso-teco .btn { flex: 1 1 100%; }
.enlaces-pie { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

/* Formulario de bienvenida */
.campo { display: flex; flex-direction: column; gap: 6px; }
.campo label { font-weight: 700; }
.entrada {
  min-height: 56px; border-radius: 16px; border: 3px solid var(--line); background: var(--surface-2);
  padding: 8px 14px; font-size: 1.3rem; font-family: var(--f-titulo); width: 100%;
}
.entrada:focus { border-color: var(--sky); outline: none; }
.avatares { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.avatar-op { min-height: 64px; font-size: 2.1rem; border-radius: 18px; border: 3px solid var(--line); background: var(--surface-2); cursor: pointer; position: relative; }
.avatar-op[aria-pressed="true"] { border-color: var(--sky); background: var(--t3); }
.avatar-op[aria-pressed="true"]::after { content: "✔"; position: absolute; top: 2px; right: 6px; font-size: .9rem; color: var(--on-color); font-weight: 700; }
.error-campo { color: var(--mal); font-weight: 700; }

/* ---------- Chips (selección de tablas y opciones) ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  min-width: 52px; min-height: 52px; padding: 4px 12px; border-radius: 16px; border: 3px solid var(--line);
  background: var(--surface-2); font-family: var(--f-titulo); font-weight: 600; font-size: 1.2rem; cursor: pointer;
}
.chip[aria-pressed="true"] { background: var(--sky); border-color: var(--sky); color: var(--sobre-fuerte); }
.chip[aria-pressed="true"]::before { content: "✔ "; font-size: .9em; }
.rejilla-12 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.opciones-modo { display: grid; gap: 10px; }
.op-modo { display: flex; align-items: center; gap: 12px; text-align: left; min-height: 64px; padding: 8px 14px; border-radius: 18px; border: 3px solid var(--line); background: var(--surface-2); cursor: pointer; }
.op-modo .ico { font-size: 1.8rem; }
.op-modo b { font-family: var(--f-titulo); font-size: 1.15rem; display: block; }
.op-modo small { color: var(--muted); }
.op-modo[aria-pressed="true"] { border-color: var(--sky); background: var(--t3); color: var(--on-color); }
.op-modo[aria-pressed="true"] small { color: var(--on-color); }
.op-modo[aria-pressed="true"]::after { content: "✔"; margin-left: auto; font-weight: 700; font-size: 1.3rem; }

/* ---------- Aprender ---------- */
.boton-tabla { min-height: 72px; border-radius: 18px; border: 3px solid var(--line); background: var(--surface); font-family: var(--f-titulo); font-size: 1.8rem; font-weight: 700; cursor: pointer; box-shadow: 0 4px 0 var(--sombra); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; gap: 4px; }
.boton-tabla small { font-size: .75rem; font-family: var(--f-texto); font-weight: 700; }
.boton-tabla:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--sombra); }
.lista-tabla { display: grid; gap: 8px; }
.renglon { display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 6px 16px; border-radius: 16px; border: 2px solid var(--line); background: var(--surface); font-family: var(--f-titulo); font-size: 1.45rem; font-weight: 600; cursor: pointer; font-variant-numeric: tabular-nums; width: 100%; }
.renglon[aria-expanded="true"] { border-color: var(--sky); background: var(--t3); color: var(--on-color); }
.renglon .res { color: var(--sky); font-weight: 700; }
.renglon[aria-expanded="true"] .res { color: var(--on-color); }
.visual { background: var(--surface-2); border: 2px dashed var(--sky); border-radius: 16px; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
.grupos { display: flex; flex-wrap: wrap; gap: 8px; }
.grupo { border: 2px solid var(--line); background: var(--surface); border-radius: 14px; padding: 4px 6px; display: flex; flex-wrap: wrap; max-width: 100%; font-size: 1.25rem; line-height: 1.2; animation: aparecer .35s ease both; }
.truco { border-radius: 18px; padding: 14px; background: var(--surface-2); border: 2px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
.truco h3::before { content: "💡 "; }
.matriz { display: grid; gap: 4px; justify-content: center; transition: transform .5s ease; margin: 6px auto; }
.matriz i { width: 16px; height: 16px; border-radius: 50%; background: var(--coral); display: block; }
.nav-tablas { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

/* ---------- Mi camino y lección guiada ---------- */
.camino-etapa { display: flex; flex-direction: column; gap: 6px; }
.camino-etapa > b { font-size: .95rem; }
.camino-nodos { display: flex; flex-wrap: wrap; gap: 10px; }
.nodo { position: relative; width: 56px; height: 56px; padding: 0; border-radius: 50%; border: 3px solid var(--line); background: var(--surface-2); font-family: var(--f-titulo); font-size: 1.35rem; font-weight: 700; cursor: pointer; display: grid; place-items: center; }
.nodo.hecha { background: var(--ok-suave); border-color: var(--ok); color: var(--ok); }
.nodo.hecha::after { content: "✔"; position: absolute; top: -5px; right: -5px; width: 22px; height: 22px; border-radius: 50%; background: var(--ok); color: var(--surface); font-size: 13px; display: grid; place-items: center; }
.nodo.siguiente { background: var(--sun); border-color: var(--sun-dark); color: var(--on-color); animation: latido 1.8s ease-in-out infinite; }
.pasos-leccion { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
.paso-l { display: flex; flex-direction: column; align-items: center; padding: 4px 2px; border-radius: 14px; border: 2px solid var(--line); background: var(--surface); color: var(--muted); font-size: .85rem; font-weight: 700; line-height: 1.2; }
.paso-l span { font-size: 1.15rem; }
.paso-l.actual { border-color: var(--sky); background: var(--t3); color: var(--on-color); }
.paso-l.hecho { border-color: var(--ok); background: var(--ok-suave); color: var(--ink); }
.cuenta-grande { font-family: var(--f-titulo); font-size: 1.7rem; font-weight: 700; line-height: 1.2; text-align: center; font-variant-numeric: tabular-nums; min-height: 2.4em; display: flex; flex-direction: column; justify-content: center; }
.cuenta-grande small { font-size: .65em; color: var(--muted); }
.rastro { font-family: var(--f-titulo); font-weight: 600; font-size: 1.2rem; line-height: 1.3; text-align: center; font-variant-numeric: tabular-nums; min-height: 2.6em; overflow-wrap: anywhere; }
.grupo.mini { font-size: 1rem; }
.rejilla-orden { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.ficha-num { min-height: 64px; padding: 0; border-radius: 16px; border: 2px solid var(--line); background: var(--surface); font-family: var(--f-titulo); font-size: 1.55rem; font-weight: 700; font-variant-numeric: tabular-nums; cursor: pointer; box-shadow: 0 4px 0 var(--sombra); }
.ficha-num:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--sombra); }
.ficha-num.mal { border-color: var(--mal); animation: sacude .4s ease; }
.ficha-num.ok { background: var(--ok-suave); border-color: var(--ok); color: var(--ok); box-shadow: none; }
.ficha-num.ok::before { content: "✔"; font-size: .6em; margin-right: 2px; }

/* ---------- Practicar / juegos: pregunta y respuestas ---------- */
.sesion-cabeza { display: flex; justify-content: space-between; gap: 8px; font-weight: 700; color: var(--muted); flex-wrap: wrap; }
.avance { height: 14px; border-radius: 999px; background: var(--line); overflow: hidden; }
.avance i { display: block; height: 100%; background: var(--mint); border-radius: 999px; transition: width .4s ease; }
.tiempo { height: 12px; border-radius: 999px; background: var(--line); overflow: hidden; }
.tiempo i { display: block; height: 100%; width: 100%; background: var(--sun-dark); border-radius: 999px; }
.pregunta-caja { background: var(--surface); border: 3px solid var(--line); border-radius: 26px; padding: 18px 12px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.pregunta { font-family: var(--f-titulo); font-weight: 700; font-size: 3rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
.hueco { display: inline-block; min-width: 1.9em; border-bottom: 5px solid var(--sun); color: var(--sky); }
.pregunta-caja.sacude { animation: sacude .5s ease; }
.etiqueta { font-weight: 700; font-size: .95rem; color: var(--muted); }
.opciones { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.opcion {
  min-height: 84px; border-radius: 22px; border: 3px solid var(--line); background: var(--surface);
  font-family: var(--f-titulo); font-size: 2.2rem; font-weight: 700; cursor: pointer; box-shadow: 0 5px 0 var(--sombra);
  font-variant-numeric: tabular-nums;
}
.opcion:active { transform: translateY(4px); box-shadow: 0 1px 0 var(--sombra); }
.opcion.ok { background: var(--ok-suave); border-color: var(--ok); color: var(--ok); }
.opcion.ok::before { content: "✔ "; }
.opcion.mal { background: var(--mal-suave); border-color: var(--mal); color: var(--mal); }
.opcion.mal::before { content: "✖ "; }
.teclado { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.tecla { min-height: 64px; border-radius: 18px; border: 2px solid var(--line); background: var(--surface); font-family: var(--f-titulo); font-size: 1.9rem; font-weight: 700; cursor: pointer; box-shadow: 0 4px 0 var(--sombra); }
.tecla:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--sombra); }
.tecla.ok-t { background: var(--sun); color: var(--on-color); border-color: var(--sun-dark); box-shadow: 0 4px 0 var(--sun-dark); font-size: 1.4rem; }
.retro { min-height: 0; border-radius: 18px; font-weight: 700; display: flex; flex-direction: column; gap: 8px; }
.retro:empty { display: none; }
.retro.ok { background: var(--ok-suave); border: 3px solid var(--ok); padding: 12px 14px; color: var(--ink); }
.retro.mal { background: var(--mal-suave); border: 3px solid var(--mal); padding: 12px 14px; color: var(--ink); }
.retro .titulo-retro { font-family: var(--f-titulo); font-size: 1.35rem; }
.retro.ok .titulo-retro { color: var(--ok); }
.retro.mal .titulo-retro { color: var(--mal); }
.resultados { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.resultado { background: var(--surface-2); border: 2px solid var(--line); border-radius: 18px; padding: 12px; text-align: center; }
.resultado b { display: block; font-family: var(--f-titulo); font-size: 2rem; font-variant-numeric: tabular-nums; }
.grande-centro { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.trofeo { font-size: 4rem; line-height: 1; animation: salta .8s ease; }
.marcador-juego { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-family: var(--f-titulo); font-size: 1.3rem; font-weight: 700; flex-wrap: wrap; }
.reloj { background: var(--sun); color: var(--on-color); border-radius: 14px; padding: 4px 12px; font-variant-numeric: tabular-nums; }
.reloj.urgente { background: var(--coral); }

/* ---------- Memorama ---------- */
.memorama { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; perspective: 800px; }
.carta { position: relative; aspect-ratio: 1 / 1.05; max-width: 100%; border: 0; padding: 0; background: none; cursor: pointer; transform-style: preserve-3d; transition: transform .45s ease; }
.carta.volteada, .carta.hecha { transform: rotateY(180deg); }
.cara { position: absolute; inset: 0; border-radius: 18px; display: grid; place-items: center; backface-visibility: hidden; -webkit-backface-visibility: hidden; font-family: var(--f-titulo); font-weight: 700; border: 3px solid var(--line); }
.cara.dorso { background: var(--grape); color: var(--sobre-fuerte); font-size: 2rem; border-color: var(--grape); background-image: radial-gradient(rgba(255,255,255,.25) 2px, transparent 2.5px); background-size: 14px 14px; }
.cara.frente { transform: rotateY(180deg); background: var(--surface); font-size: 1.5rem; color: var(--ink); }
.cara.frente.es-res { background: var(--t1); color: var(--on-color); font-size: 1.9rem; border-color: var(--sun-dark); }
.carta.hecha .cara.frente { border-color: var(--ok); }
.carta.hecha .cara.frente::after { content: "✔"; position: absolute; top: 4px; right: 8px; font-size: 1rem; color: var(--ok); }
.carta.hecha .cara.frente.es-res::after { color: var(--on-color); }

/* ---------- Globos ---------- */
.cielo { position: relative; height: 56vh; min-height: 340px; border-radius: 24px; overflow: hidden; border: 3px solid var(--line); background: linear-gradient(var(--t3), var(--surface-2)); }
.globo {
  position: absolute; bottom: -120px; width: 84px; height: 100px; margin-left: -42px; border: 0; cursor: pointer;
  border-radius: 50% 50% 48% 48% / 56% 56% 44% 44%; color: var(--on-color);
  font-family: var(--f-titulo); font-size: 1.8rem; font-weight: 700; font-variant-numeric: tabular-nums;
  box-shadow: inset -10px -12px 0 rgba(0,0,0,.12);
  animation: subir var(--dur, 9s) linear var(--retraso, 0s) infinite;
}
.globo::after { content: ""; position: absolute; left: 50%; top: 100%; width: 2px; height: 34px; background: var(--muted); }
.globo.reventado { animation: reventar .35s ease forwards; pointer-events: none; }
.globo.fallo { outline: 4px dashed var(--mal); }
.globo.fallo::before { content: "✖"; position: absolute; top: -6px; right: -6px; background: var(--surface); color: var(--mal); border-radius: 50%; width: 28px; height: 28px; font-size: 1rem; display: grid; place-items: center; }

/* ---------- Métodos del mundo ---------- */
.lista-metodos { display: grid; gap: 10px; }
.metodo-ficha { display: flex; align-items: center; gap: 12px; text-align: left; min-height: 72px; padding: 10px 14px; border-radius: 20px; border: 2px solid var(--line); background: var(--surface); cursor: pointer; box-shadow: 0 4px 0 var(--sombra); width: 100%; }
.metodo-ficha .bandera { font-size: 2rem; flex: none; }
.metodo-ficha b { font-family: var(--f-titulo); font-size: 1.15rem; display: block; line-height: 1.15; }
.metodo-ficha small { color: var(--muted); }
.metodo-ficha .txt-c { flex: 1; min-width: 0; }
.visto { font-size: .85rem; font-weight: 700; color: var(--ok); white-space: nowrap; }
.cabeza-metodo { display: flex; gap: 12px; align-items: center; }
.cabeza-metodo .bandera { font-size: 2.6rem; }
.lienzo-demo { background: var(--surface-2); border: 2px solid var(--line); border-radius: 18px; padding: 10px; min-height: 220px; display: grid; place-items: center; overflow-x: auto; }
.lienzo-demo svg { width: 100%; max-width: 360px; height: auto; display: block; }
.texto-paso { font-size: 1.1rem; font-weight: 700; min-height: 3em; }
.contador-paso { color: var(--muted); font-weight: 700; font-size: .95rem; }
.ej-libre { display: flex; flex-direction: column; gap: 12px; }
/* Ejercicio guiado "Hazlo conmigo": cabe en una pantalla de celular con todo y teclado */
.guia { display: flex; flex-direction: column; gap: 8px; scroll-margin-top: 72px; }
.guia .lienzo-demo { min-height: 0; padding: 6px; }
.guia .lienzo-demo svg { max-height: 230px; }
.guia .tabla-metodo { font-size: 1.15rem; border-spacing: 0 3px; }
.guia .tabla-metodo td { padding: 1px 16px; }
.guia .vedico { font-size: 1.35rem; }
.guia-preg { display: flex; align-items: center; gap: 10px; }
.guia-preg .texto-paso { flex: 1; min-width: 0; min-height: 0; font-size: 1.05rem; line-height: 1.3; }
.guia-resp { flex: none; min-width: 84px; min-height: 56px; padding: 0 10px; display: grid; place-items: center; border-radius: 14px; border: 3px solid var(--sun-dark); background: var(--surface-2); color: var(--ink); font-size: 1.8rem; font-weight: 700; }
.guia-resp.ok { border-color: var(--ok); background: var(--ok-suave); color: var(--ok); }
.guia-resp.sacude { animation: sacude .4s ease; }
.guia-retro { min-height: 52px; padding: 6px 12px; line-height: 1.25; font-size: 1rem; }
.guia-retro.retro:empty { display: block; }
.guia-retro.ok, .guia-retro.mal { padding: 6px 12px; }
.guia .teclado { gap: 8px; }
.guia .tecla { min-height: 54px; font-size: 1.6rem; }
.guia .tecla.ok-t { font-size: 1.2rem; }
.dato { background: var(--t5); color: var(--on-color); border-radius: 18px; padding: 14px; }
.dato b::before { content: "🔎 "; }
/* Tablas de los métodos (ruso y egipcio) */
.tabla-metodo { border-collapse: separate; border-spacing: 0 6px; margin: 0 auto; font-family: var(--f-titulo); font-size: 1.4rem; font-variant-numeric: tabular-nums; }
.tabla-metodo th { font-size: .95rem; color: var(--muted); padding: 0 14px; }
.tabla-metodo td { padding: 4px 18px; text-align: center; background: var(--surface); border-block: 2px solid var(--line); }
.tabla-metodo td:first-child { border-left: 2px solid var(--line); border-radius: 12px 0 0 12px; }
.tabla-metodo td:last-child { border-right: 2px solid var(--line); border-radius: 0 12px 12px 0; }
.tabla-metodo tr.tachada td { text-decoration: line-through; text-decoration-thickness: 3px; color: var(--muted); opacity: .7; }
.tabla-metodo tr.tachada td:last-child::after { content: " ✖"; text-decoration: none; display: inline-block; }
.tabla-metodo tr.elegida td { background: var(--ok-suave); border-color: var(--ok); }
.tabla-metodo tr.elegida td:last-child::after { content: " ✔"; color: var(--ok); display: inline-block; }
.suma-final { font-family: var(--f-titulo); font-size: 1.3rem; text-align: center; margin-top: 8px; font-weight: 700; }
.vedico { display: grid; grid-template-columns: auto auto auto; gap: 8px 14px; align-items: center; justify-content: center; font-family: var(--f-titulo); font-size: 1.6rem; font-weight: 700; }
.vedico .caja { min-width: 56px; padding: 4px 10px; text-align: center; border-radius: 12px; background: var(--surface); border: 2px solid var(--line); }
.vedico .caja.resalta { border-color: var(--sky); background: var(--t3); color: var(--on-color); }
.vedico .flecha { font-size: 1rem; color: var(--muted); font-family: var(--f-texto); }
.vedico .linea { grid-column: 1 / -1; height: 3px; background: var(--ink); border-radius: 3px; }
/* Colores para los dibujos SVG (usan los mismos tokens del tema) */
svg text { font-family: var(--f-titulo); fill: var(--ink); }
.s-l1 { stroke: var(--sky); stroke-width: 4; stroke-linecap: round; }
.s-l2 { stroke: var(--coral); stroke-width: 4; stroke-linecap: round; }
.s-pt { fill: var(--sun); stroke: var(--ink); stroke-width: 1.5; }
.s-pt.tenue { fill: var(--surface); stroke: var(--muted); opacity: .45; }
.s-borde { fill: var(--surface); stroke: var(--ink); stroke-width: 2; }
.s-diag { stroke: var(--muted); stroke-width: 1.5; }
.s-resalta { fill: var(--t1); stroke: var(--sun-dark); stroke-width: 2.5; }
.s-celda-a { fill: var(--t3); stroke: var(--ink); stroke-width: 2; }
.s-celda-b { fill: var(--t2); stroke: var(--ink); stroke-width: 2; }
.s-celda-c { fill: var(--t4); stroke: var(--ink); stroke-width: 2; }
.s-celda-d { fill: var(--t1); stroke: var(--ink); stroke-width: 2; }
.s-texto-color { fill: var(--on-color); }
.s-sky { fill: var(--sky); } .s-coral { fill: var(--coral-txt); } .s-mut { fill: var(--muted); }
.s-dedo { fill: var(--t1); stroke: var(--ink); stroke-width: 2; }
.s-dedo.a { fill: var(--t3); } .s-dedo.b { fill: var(--t2); } .s-dedo.baja { fill: var(--line); stroke-dasharray: 4 3; }
.s-palma { fill: var(--t1); stroke: var(--ink); stroke-width: 2; }
.s-recta { stroke: var(--ink); stroke-width: 3; stroke-linecap: round; }
.s-salto { fill: none; stroke: var(--coral); stroke-width: 3; }
.s-une { stroke: var(--grape); stroke-width: 4; stroke-dasharray: 6 4; }

/* ---------- Progreso ---------- */
.semaforo { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.luz { border-radius: 18px; padding: 10px 6px; text-align: center; border: 3px solid; display: flex; flex-direction: column; align-items: center; gap: 2px; }
.luz b { font-family: var(--f-titulo); font-size: 1.8rem; line-height: 1; }
.luz small { font-weight: 700; font-size: .8rem; line-height: 1.2; }
.luz.rojo { background: var(--rojo-suave); border-color: var(--rojo); }
.luz.rojo small { color: var(--rojo); }
.luz.amarillo { background: var(--amar-suave); border-color: var(--amar); }
.luz.amarillo small { color: var(--amar); }
.luz.verde { background: var(--verde-suave); border-color: var(--verde); }
.luz.verde small { color: var(--verde); }
.puntito { display: inline-block; font-size: .8rem; }
.leyenda { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .9rem; font-weight: 700; color: var(--muted); }
.insignias { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 96px), 1fr)); gap: 10px; }
.insignia { border-radius: 18px; padding: 10px 6px; text-align: center; background: var(--surface-2); border: 2px solid var(--line); display: flex; flex-direction: column; align-items: center; gap: 2px; }
.insignia .ico { font-size: 2rem; }
.insignia b { font-size: .85rem; line-height: 1.2; overflow-wrap: anywhere; hyphens: auto; }
.insignia small { font-size: .75rem; color: var(--muted); line-height: 1.2; }
.insignia.ganada { background: var(--t1); border-color: var(--sun-dark); color: var(--on-color); }
.insignia.ganada small { color: var(--on-color); }
.insignia.bloqueada .ico { filter: grayscale(1); opacity: .45; }
.dificiles { display: grid; gap: 8px; }
.dificil { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 14px; background: var(--surface-2); border: 2px solid var(--line); }
.dificil b { font-family: var(--f-titulo); font-size: 1.3rem; }
.barrita { flex: 1; height: 10px; background: var(--line); border-radius: 99px; overflow: hidden; max-width: 120px; }
.barrita i { display: block; height: 100%; background: var(--mal); }
.desplaza { overflow-x: auto; }
.tabla-padres { width: 100%; border-collapse: collapse; font-size: .95rem; font-variant-numeric: tabular-nums; }
.tabla-padres th, .tabla-padres td { padding: 8px 6px; border-bottom: 2px solid var(--line); text-align: center; }
.tabla-padres th { color: var(--muted); font-size: .85rem; }

/* Mapa 12 × 12 de multiplicaciones (solo para ver, no se toca) */
.mapa { display: grid; grid-template-columns: repeat(13, minmax(0, 1fr)); gap: 2px; font-family: var(--f-titulo); font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; }
.mapa span { aspect-ratio: 1; display: grid; place-items: center; border-radius: 5px; font-size: .78rem; min-width: 0; }
.mapa .cab { color: var(--muted); }
.mapa .vacia { background: var(--surface-2); border: 1px solid var(--line); }
.mapa .camino { background: var(--amar-suave); border: 1px solid var(--amar); color: var(--amar); font-size: 1.1rem; }
.mapa .segura { background: var(--verde); color: var(--surface); }

/* ---------- Tablero de patrones (tabla pitagórica 12 × 12) ----------
   Las celdas son chicas para que quepan las 144; por eso también se puede
   elegir con botones grandes (Fila / Columna) y con las flechas del teclado. */
.tarjeta.compacta { padding: 10px; }
.tablero { display: grid; grid-template-columns: repeat(13, minmax(0, 1fr)); gap: 2px; font-family: var(--f-titulo); font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1; touch-action: manipulation; user-select: none; -webkit-user-select: none; }
.tablero span { aspect-ratio: 1; min-width: 0; display: grid; place-items: center; border-radius: 5px; background: var(--surface-2); border: 1px solid var(--line); font-size: min(2.9vw, 13px); letter-spacing: -.03em; cursor: pointer; }
.tablero .cab { background: transparent; border-color: transparent; color: var(--muted); font-weight: 700; font-size: min(3.3vw, 15px); }
.tablero .cab.esq { cursor: default; }
.tablero .linea-sel { background: var(--t3); border-color: var(--t3); color: var(--on-color); }
.tablero .pat { background: var(--t2); border: 2px solid var(--ok); color: var(--on-color); font-weight: 700; }
.tablero .gemela { outline: 3px dashed var(--grape); outline-offset: -2px; font-weight: 700; }
.tablero .sel { background: var(--sun); border: 2px solid var(--sun-dark); color: var(--on-color); font-weight: 700; transform: scale(1.18); position: relative; z-index: 1; box-shadow: 0 2px 6px rgba(8,14,36,.3); }
.tablero .cab.sel { background: var(--sun); transform: none; box-shadow: none; }
.lectura-tab { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 4px; }
.lectura-tab .op { font-family: var(--f-titulo); font-weight: 700; font-size: 2.3rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
.elige-tab { display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; align-items: center; gap: 8px 10px; }
.elige-tab b { font-size: .95rem; }
.elige-tab .num { min-width: 2.2em; text-align: center; font-size: 1.7rem; font-weight: 700; }
.elige-tab .icono-btn { font-size: 1.5rem; font-family: var(--f-titulo); font-weight: 700; }
.patrones { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; }
.patron { display: flex; align-items: center; gap: 8px; min-height: 56px; padding: 6px 10px; border-radius: 16px; border: 3px solid var(--line); background: var(--surface-2); text-align: left; cursor: pointer; font-family: var(--f-titulo); font-weight: 600; font-size: 1rem; line-height: 1.15; position: relative; }
.patron .ico { font-size: 1.5rem; flex: none; }
.patron[aria-pressed="true"] { border-color: var(--ok); background: var(--t2); color: var(--on-color); }
.patron.descubierto::after { content: "✔"; position: absolute; top: 2px; right: 6px; font-size: .8rem; color: var(--ok); }
.patron[aria-pressed="true"].descubierto::after { color: var(--on-color); }
.matriz.chica i { width: 12px; height: 12px; background: var(--sky); }

/* ---------- Mis dibujos: la figura se pinta con cada respuesta correcta ---------- */
.lienzo-fig { display: block; aspect-ratio: 1; max-width: 100%; background: var(--surface); }
.fig-grande { width: 100%; max-width: 360px; margin: 0 auto; border: 3px solid var(--line); border-radius: 14px; }
.fig-avance { text-align: center; font-weight: 700; }
/* Sesión de pintar: la figura se ve arriba y se pinta con cada acierto */
.fig-sesion { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border-radius: 18px; border: 2px solid var(--line); background: var(--surface); }
.fig-sesion .lienzo-fig { width: 112px; flex: none; border: 2px solid var(--line); border-radius: 10px; }
.fig-sesion .txt-c { flex: 1; min-width: 0; font-weight: 700; line-height: 1.3; }
.fig-sesion b { display: block; font-family: var(--f-titulo); font-size: 1.15rem; }
.fig-sesion small { color: var(--muted); }
.dibujo-ini { display: flex; align-items: center; gap: 12px; width: 100%; padding: 10px 14px; border-radius: 22px; border: 2px solid var(--line); background: var(--surface); color: var(--ink); text-align: left; cursor: pointer; box-shadow: 0 4px 0 var(--sombra); }
.dibujo-ini:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--sombra); }
.dibujo-ini .lienzo-fig { width: 76px; flex: none; border: 2px solid var(--line); border-radius: 10px; }
.dibujo-ini .txt-c { flex: 1; min-width: 0; }
.dibujo-ini b { display: block; font-family: var(--f-titulo); font-size: 1.2rem; line-height: 1.15; }
.rejilla-figs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.tile-fig { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 6px; min-width: 0; border-radius: 16px; border: 3px solid var(--line); background: var(--surface-2); color: var(--ink); cursor: pointer; line-height: 1.15; }
.tile-fig .lienzo-fig { width: 100%; border-radius: 8px; }
.tile-fig b { font-size: .85rem; overflow-wrap: anywhere; }
.tile-fig small { font-size: .78rem; color: var(--muted); font-weight: 700; }
.tile-fig[aria-pressed="true"] { border-color: var(--sky); background: var(--t3); color: var(--on-color); }
.tile-fig[aria-pressed="true"] small { color: var(--on-color); }
.btn-subir { width: 100%; }
.btn-subir:focus-within { outline: 4px solid var(--foco); outline-offset: 3px; }
.fig-flota { position: fixed; z-index: 65; top: calc(64px + env(safe-area-inset-top, 0px)); right: max(8px, env(safe-area-inset-right, 0px)); width: 68px; padding: 3px; border-radius: 14px; background: var(--surface); border: 3px solid var(--sun-dark); box-shadow: 0 6px 18px rgba(8,14,36,.3); pointer-events: none; text-align: center; font-family: var(--f-titulo); font-size: .68rem; font-weight: 700; font-variant-numeric: tabular-nums; animation: pop .4s ease; }
.fig-flota .lienzo-fig { width: 100%; }
/* Más operaciones (próximamente) */
.op-futura { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 18px; background: var(--surface); border: 2px dashed var(--line); }
.op-futura .ico { font-size: 2rem; flex: none; }
.op-futura .txt-c { flex: 1; min-width: 0; }
.op-futura b { display: block; font-family: var(--f-titulo); font-size: 1.15rem; }
/* Divisiones: platos para repartir y familia de operaciones */
.op-lista { display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 14px; border-radius: 18px; background: var(--t6); color: var(--on-color); border: 0; text-align: left; cursor: pointer; box-shadow: 0 4px 0 rgba(21,34,74,.28); }
.op-lista:active { transform: translateY(3px); box-shadow: 0 1px 0 rgba(21,34,74,.28); }
.op-lista .ico { font-size: 2rem; flex: none; }
.op-lista .txt-c { flex: 1; min-width: 0; }
.op-lista b { display: block; font-family: var(--f-titulo); font-size: 1.15rem; }
.etiqueta-nuevo { flex: none; padding: 2px 10px; border-radius: 999px; background: var(--surface); color: var(--ink); border: 2px solid var(--on-color); font-size: .8rem; font-weight: 700; }
.bolsa { min-height: 2.2em; padding: 8px 10px; border-radius: 16px; border: 2px dashed var(--line); background: var(--surface-2); font-size: 1.35rem; line-height: 1.25; text-align: center; overflow-wrap: anywhere; }
.platos { display: grid; grid-template-columns: repeat(auto-fit, minmax(84px, 1fr)); gap: 10px; }
.plato { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 6px; border-radius: 50% / 22%; border: 3px solid var(--line); background: var(--surface); min-height: 92px; }
