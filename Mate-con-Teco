const vista = $('#vista');
const RUTAS = {
  inicio: { titulo: 'Mate con Teco', pinta: v => pintaInicio(v) },
  aprender: { titulo: 'Aprender', padre: 'inicio', pinta: v => pintaAprender(v) },
