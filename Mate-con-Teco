/* =====================================================================
   6. CONFETI Y ESTRELLAS (lienzo encima de todo)
   ===================================================================== */
const lienzo = $('#confeti');
const cx = lienzo.getContext ? lienzo.getContext('2d') : null;
let particulas = [], animandoConfeti = false;
const COLORES_CONFETI = ['#FFC53D', '#FF6F5B', '#22A86B', '#2F6FEB', '#6B4BF0', '#FF9EC7'];
function confeti(n = 50) {
  if (!cx) return;
  if (sinMovimiento()) n = Math.min(n, 10);
  const w = lienzo.width = innerWidth, h = lienzo.height = innerHeight;
  for (let i = 0; i < n; i++) {
    particulas.push({
      x: w / 2 + (Math.random() - .5) * w * .5, y: h * .35, vx: (Math.random() - .5) * 9, vy: -Math.random() * 9 - 3,
      r: 5 + Math.random() * 6, rot: Math.random() * 6, vr: (Math.random() - .5) * .3, c: azar(COLORES_CONFETI),
      estrella: Math.random() < .45, vida: 0
    });
  }
  if (!animandoConfeti) { animandoConfeti = true; requestAnimationFrame(pasoConfeti); }
}
function dibujaEstrella(r) {
  cx.beginPath();
  for (let i = 0; i < 10; i++) { const a = i * Math.PI / 5 - Math.PI / 2, rr = i % 2 ? r * .45 : r; cx.lineTo(Math.cos(a) * rr, Math.sin(a) * rr); }
  cx.closePath(); cx.fill();
}
function pasoConfeti() {
  cx.clearRect(0, 0, lienzo.width, lienzo.height);
  particulas.forEach(p => {
    p.vy += .25; p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.vida++;
    cx.save(); cx.translate(p.x, p.y); cx.rotate(p.rot); cx.fillStyle = p.c;
    if (p.estrella) dibujaEstrella(p.r); else cx.fillRect(-p.r / 2, -p.r / 4, p.r, p.r / 2);
    cx.restore();
  });
  particulas = particulas.filter(p => p.y < lienzo.height + 30 && p.vida < 240);
  if (particulas.length) requestAnimationFrame(pasoConfeti);
  else { animandoConfeti = false; cx.clearRect(0, 0, lienzo.width, lienzo.height); }
}

