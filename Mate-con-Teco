  metodos: { titulo: 'Métodos del mundo', padre: 'inicio', pinta: v => pintaMetodos(v) },
  patrones: { titulo: 'Tablero de patrones', padre: 'aprender', pinta: v => pintaPatrones(v) },
  progreso: { titulo: 'Mi progreso', padre: 'inicio', pinta: v => pintaProgreso(v) },
  padres: { titulo: 'Padres y maestros', padre: 'inicio', pinta: v => pintaPadres(v) },
  dibujos: { titulo: 'Mis dibujos', padre: 'inicio', pinta: v => pintaDibujos(v) },
  operaciones: { titulo: 'Todas las operaciones', padre: 'inicio', pinta: v => pintaOperaciones(v) },
  divisiones: { titulo: 'Divisiones', padre: 'inicio', pinta: v => pintaDivisiones(v) },
  sumas: { titulo: 'Sumas', padre: 'inicio', pinta: v => pintaSumas(v) },
  restas: { titulo: 'Restas', padre: 'inicio', pinta: v => pintaRestas(v) },
  quebrados: { titulo: 'Quebrados', padre: 'inicio', pinta: v => pintaQuebrados(v) },
  acerca: { titulo: 'Acerca de', padre: 'inicio', pinta: v => pintaAcerca(v) }
};
function rutaActual() {
  const h = (location.hash || '').slice(1) || 'inicio';
  if (RUTAS[h]) return Object.assign({ id: h }, RUTAS[h]);
  let m = h.match(/^tabla-(\d{1,2})$/);
  if (m && +m[1] >= 1 && +m[1] <= 12) return { id: h, titulo: 'Tabla del ' + m[1], padre: 'aprender', pinta: v => pintaTabla(v, +m[1]) };
  m = h.match(/^leccion-(\d{1,2})$/);
  if (m && +m[1] >= 1 && +m[1] <= 12) return { id: h, titulo: 'Lección del ' + m[1], padre: 'aprender', pinta: v => pintaLeccion(v, +m[1]) };
  m = h.match(/^metodo-([a-z]+)$/);
  if (m && METODOS.find(x => x.id === m[1])) return { id: h, titulo: 'Métodos del mundo', padre: 'metodos', pinta: v => pintaMetodo(v, m[1]) };
  m = h.match(/^juego-([a-z]+)$/);
  if (m && JUEGOS[m[1]]) return { id: h, titulo: JUEGOS[m[1]].nombre, padre: 'juegos', pinta: v => JUEGOS[m[1]].pinta(v) };
  return Object.assign({ id: 'inicio' }, RUTAS.inicio);
}
function ir(id) { if ((location.hash || '').slice(1) === id) render(); else location.hash = id; }
function render() {
  detenerTodo();
  let r = rutaActual();
  if (r.id !== 'padres') padresAbierto = false; // el candado vuelve a cerrarse al salir
  if (!E.nombre && r.id !== 'acerca') r = Object.assign({ id: 'inicio' }, RUTAS.inicio);
  $('#titulo-pantalla').textContent = r.titulo;
  $('#btn-atras').hidden = !r.padre;
  vista.innerHTML = '';
  r.pinta(vista);
  window.scrollTo(0, 0);
  try { vista.focus({ preventScroll: true }); } catch (e) { vista.focus(); }
}
window.addEventListener('hashchange', render);

