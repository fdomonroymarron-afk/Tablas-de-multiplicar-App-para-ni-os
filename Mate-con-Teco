   11. SELECTOR DE TABLAS (se usa en Practicar y en los Juegos)
   ===================================================================== */
function selectorTablas(cont, seleccion, alCambiar) {
  cont.innerHTML = `<div class="chips" role="group" aria-label="Tablas">${Array.from({ length: 12 }, (_, i) => i + 1).map(t => `<button class="chip" type="button" data-t="${t}" aria-pressed="${seleccion.includes(t)}">${t}</button>`).join('')}</div>
    <div class="fila"><button class="btn chico" type="button" data-todas>Todas</button><button class="btn chico" type="button" data-ninguna>Ninguna</button>
    ${E.refuerzo.length ? '<button class="btn chico" type="button" data-refuerzo>📌 Las que pidió el adulto</button>' : ''}</div>`;
  const pinta = () => { $$('[data-t]', cont).forEach(b => b.setAttribute('aria-pressed', seleccion.includes(+b.dataset.t))); alCambiar && alCambiar(seleccion); };
  $$('[data-t]', cont).forEach(b => b.onclick = () => {
    const t = +b.dataset.t, i = seleccion.indexOf(t);
    if (i >= 0) seleccion.splice(i, 1); else seleccion.push(t);
    seleccion.sort((x, y) => x - y); sonidos.clic(); pinta();
  });
  $('[data-todas]', cont).onclick = () => { seleccion.splice(0, seleccion.length, ...Array.from({ length: 12 }, (_, i) => i + 1)); pinta(); };
  $('[data-ninguna]', cont).onclick = () => { seleccion.splice(0, seleccion.length); pinta(); };
  const rf = $('[data-refuerzo]', cont); if (rf) rf.onclick = () => { seleccion.splice(0, seleccion.length, ...E.refuerzo); pinta(); };
}
