/* =====================================================================
   3 B. MIS DIBUJOS
   Cada figura es una cuadrícula de 12 × 12 = 144 cuadritos, uno por cada
   multiplicación de las tablas. Al acertar 3 × 7 se pintan los cuadritos
   3 × 7 y 7 × 3 (son gemelas), así que 78 aciertos distintos completan la
   figura. Si esos cuadritos ya estaban pintados, se pinta el siguiente par
   libre desde el centro: cada respuesta correcta siempre dibuja algo.
   ===================================================================== */
const LADO = 12, CUADROS = LADO * LADO, MAX_FIGS = 12, CLAVE_FIGS = 'tablas-mx-figuras';
const CATALOGO = [
  ['🦊', 'Zorro'], ['🐼', 'Panda'], ['🐸', 'Rana'], ['🦁', 'León'], ['🐙', 'Pulpo'], ['🦄', 'Unicornio'],
  ['🐢', 'Tortuga'], ['🚀', 'Cohete'], ['🐱', 'Gato'], ['🐶', 'Perro'], ['🦖', 'Dinosaurio'], ['🐝', 'Abeja'],
  ['🦉', 'Búho'], ['🐘', 'Elefante'], ['🦒', 'Jirafa'], ['🐬', 'Delfín'], ['🦋', 'Mariposa'], ['🐞', 'Catarina'],
  ['🐧', 'Pingüino'], ['🦜', 'Perico'], ['🐨', 'Koala'], ['🐯', 'Tigre'], ['🐰', 'Conejo'], ['🐵', 'Mono']
].map(([id, nombre]) => ({ id, nombre }));
/* Figuras subidas: van en otra clave porque pesan más que el avance */
function cargarFiguras() { try { const t = JSON.parse(localStorage.getItem(CLAVE_FIGS)); return Array.isArray(t) ? t : []; } catch (e) { return []; } }
function guardarFiguras() { try { localStorage.setItem(CLAVE_FIGS, JSON.stringify(FIGS)); return true; } catch (e) { return false; } }
let FIGS = cargarFiguras();
const todasFiguras = () => CATALOGO.concat(FIGS);
const figura = id => todasFiguras().find(f => f.id === id);
/* Los 78 pares de gemelas, del centro de la figura hacia afuera */
const PARES = [];
for (let a = 1; a <= LADO; a++) for (let b = a; b <= LADO; b++) PARES.push([a, b]);
PARES.sort((x, y) => (Math.hypot(x[0] - 6.5, x[1] - 6.5)) - (Math.hypot(y[0] - 6.5, y[1] - 6.5)));
const mapaFig = id => E.fig.avance[id] || '0'.repeat(CUADROS);
const pintados = id => mapaFig(id).split('1').length - 1;
const indice = (a, b) => (a - 1) * LADO + (b - 1);
/* Figura en la que se está trabajando: la elegida o, si no hay, el avatar */
function figActual() {
  const lista = [E.avatar, E.fig.actual].concat(todasFiguras().map(f => f.id));
  if (E.fig.actual && figura(E.fig.actual) && !E.fig.hechas.includes(E.fig.actual)) return E.fig.actual;
  const id = lista.find(x => figura(x) && !E.fig.hechas.includes(x)) || null;
  E.fig.actual = id;
  return id;
}
let piezasPintadas = 0; // contador de esta visita, para el resumen de cada sesión
function pintarPieza(a, b) {
  const id = figActual(); if (!id) return;
  const m = mapaFig(id).split(''), libre = (x, y) => m[indice(x, y)] === '0';
  const enTabla = a >= 1 && a <= LADO && b >= 1 && b <= LADO;
  const par = enTabla && (libre(a, b) || libre(b, a)) ? [a, b] : PARES.find(([x, y]) => libre(x, y) || libre(y, x));
  if (!par) return;
  const nuevas = [[par[0], par[1]], [par[1], par[0]]].filter(([x, y], i) => libre(x, y) && (i === 0 || par[0] !== par[1]));
  nuevas.forEach(([x, y]) => { m[indice(x, y)] = '1'; });
  E.fig.avance[id] = m.join(''); piezasPintadas++;
  mostrarFlotante(id, nuevas);
  if (pintados(id) === CUADROS) completarFigura(id);
}
function completarFigura(id) {
  E.fig.hechas.push(id); E.fig.actual = null;
  ganarEstrellas(10); sonidos.gana(); confeti(90);
  aviso(`🎨 ¡Completaste tu dibujo de ${figura(id).nombre}! +10 ⭐`);
}
/* Imágenes listas para dibujar: los emojis se pasan a un lienzo una sola vez */
const cacheFig = {};
function imagenFigura(id, alCargar) {
  if (cacheFig[id]) return cacheFig[id].listo === false ? null : cacheFig[id];
  const f = figura(id); if (!f) return null;
  if (f.src) {
    const img = new Image(); img.listo = false;
    img.onload = () => { img.listo = true; if (alCargar) alCargar(); };
    img.src = f.src; cacheFig[id] = img;
    return null;
  }
  const c = document.createElement('canvas'); c.width = c.height = 480;
  const x = c.getContext('2d');
  x.font = '390px "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif';
  x.textAlign = 'center'; x.textBaseline = 'middle';
  x.fillText(id, 240, 262);
  cacheFig[id] = c;
  return c;
}
function pintarLienzo(cv, id, nuevas = []) {
  const x = cv && cv.getContext && cv.getContext('2d'); if (!x || !id) return;
  const W = cv.width, cs = W / LADO, m = mapaFig(id), img = imagenFigura(id, () => pintarLienzo(cv, id, nuevas));
  const estilo = getComputedStyle(document.documentElement), iw = img ? (img.naturalWidth || img.width) : 0, ics = iw / LADO;
  x.clearRect(0, 0, W, W);
  if (img) { x.globalAlpha = .1; x.drawImage(img, 0, 0, W, W); x.globalAlpha = 1; }
  x.strokeStyle = estilo.getPropertyValue('--line'); x.lineWidth = Math.max(1, W / 480);
  for (let f = 0; f < LADO; f++) for (let c = 0; c < LADO; c++) {
    const X = Math.round(c * cs), Y = Math.round(f * cs);
    if (m[f * LADO + c] === '1') { if (img) x.drawImage(img, c * ics, f * ics, ics, ics, X, Y, Math.ceil(cs), Math.ceil(cs)); }
    else x.strokeRect(X, Y, cs, cs);
  }
  x.strokeStyle = estilo.getPropertyValue('--sun-dark'); x.lineWidth = Math.max(2, W / 120);
  nuevas.forEach(([a, b]) => x.strokeRect((b - 1) * cs, (a - 1) * cs, cs, cs));
}
/* Dibujito flotante: aparece un momento con los cuadritos recién pintados */
let idFlota = null;
function mostrarFlotante(id, nuevas) {
  const fs = $('#fig-sesion-c');
  if (fs && S && S.cfg.dibujo === id) {
    pintarLienzo(fs, id, nuevas);
    const t = $('#fig-sesion-t'); if (t) t.textContent = `${pintados(id)} de ${CUADROS} cuadritos`;
    return;
  }
  const f = $('#fig-flota');
  f.hidden = true; void f.offsetWidth; f.hidden = false;
  pintarLienzo($('#fig-flota-c'), id, nuevas);
  $('#fig-flota-t').textContent = pintados(id) + '/' + CUADROS;
  clearTimeout(idFlota); idFlota = setTimeout(() => { f.hidden = true; }, 1500);
}

/* =====================================================================
   4. SONIDOS (Web Audio, cortos y opcionales)
   ===================================================================== */
let ctxAudio = null;
function tono(frec, dur = 0.12, tipo = 'sine', cuando = 0, vol = 0.16) {
  if (!E.sonido) return;
  try {
    if (!ctxAudio) { const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return; ctxAudio = new AC(); }
    if (ctxAudio.state === 'suspended') ctxAudio.resume();
    const t0 = ctxAudio.currentTime + cuando;
    const o = ctxAudio.createOscillator(), g = ctxAudio.createGain();
    o.type = tipo; o.frequency.value = frec;
    g.gain.setValueAtTime(0.0001, t0);
    g.gain.exponentialRampToValueAtTime(vol, t0 + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
    o.connect(g); g.connect(ctxAudio.destination);
    o.start(t0); o.stop(t0 + dur + 0.05);
  } catch (e) { /* sin audio */ }
}
const sonidos = {
  bien() { tono(660, .12, 'triangle'); tono(880, .2, 'triangle', .1); },
  mal() { tono(330, .18, 'sine', 0, .1); tono(262, .25, 'sine', .14, .08); },
  gana() { [523, 659, 784, 1047].forEach((f, i) => tono(f, .2, 'triangle', i * .11)); },
  pop() { tono(880, .07, 'square', 0, .06); tono(1320, .05, 'sine', .04, .05); },
  clic() { tono(520, .05, 'sine', 0, .05); }
};

