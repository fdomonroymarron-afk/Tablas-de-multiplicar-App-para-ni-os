<script>
'use strict';
/* =====================================================================
   1. UTILIDADES GENERALES
   ===================================================================== */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
const rnd = (a, b) => a + Math.floor(Math.random() * (b - a + 1));
function barajar(arr) { for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; } return arr; }
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const azar = arr => arr[Math.floor(Math.random() * arr.length)];
function fechaTexto(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
const hoy = () => fechaTexto(new Date());
function ayer() { const d = new Date(); d.setDate(d.getDate() - 1); return fechaTexto(d); }
function mmss(seg) { const m = Math.floor(seg / 60), s = seg % 60; return m + ':' + String(s).padStart(2, '0'); }
const sinMovimiento = () => { try { return matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { return false; } };

/* Temporizadores de la pantalla actual: se limpian al cambiar de pantalla */
let temporizadores = [];
function cada(fn, ms) { const id = setInterval(fn, ms); temporizadores.push(id); return id; }
function luego(fn, ms) { const id = setTimeout(fn, ms); temporizadores.push(id); return id; }
function detenerTodo() {
  temporizadores.forEach(id => { clearInterval(id); clearTimeout(id); });
  temporizadores = [];
  teclaActiva = null;
  try { if (hayVoz) speechSynthesis.cancel(); } catch (e) { /* sin voz */ }
}

/* =====================================================================
   2. ESTADO Y GUARDADO (localStorage protegido con try/catch)
   ===================================================================== */
const CLAVE = 'tablas-mx-v1';
/* Multiplicaciones gemelas: 3 × 7 y 7 × 3 son el mismo hecho y se guardan juntas,
   siempre con el número menor primero ("3x7"). Por eso son 78 hechos y no 144. */
const claveHecho = (a, b) => Math.min(a, b) + 'x' + Math.max(a, b);
const TOTAL_HECHOS = 78;
/* Convierte el avance guardado por versiones anteriores ("7x3" aparte de "3x7") */
function unirGemelas(hechos) {
  const u = {};
  Object.entries(hechos).forEach(([k, h]) => {
    const [a, b] = k.split('x').map(Number), c = claveHecho(a, b), y = u[c];
    if (!y) { u[c] = Object.assign({}, h); return; }
    y.ok += h.ok; y.mal += h.mal; y.racha = Math.max(y.racha, h.racha);
    if (h.ult && (!y.ult || h.ult > y.ult)) y.ult = h.ult;
  });
  return u;
}
/* Unificación de las dos versiones de la app: quien ya usaba la primera (clave
   'tablasMx_v1', con otros nombres de campos) conserva su avance al abrir esta.
   La clave vieja no se borra: se queda como respaldo en el dispositivo. */
const CLAVE_ANTERIOR = 'tablasMx_v1';
function desdeVersionAnterior(o) {
  const e = estadoInicial();
  const metodo = id => id === 'saltos' ? 'conteo' : id;   // mismo método, otro identificador
  const medalla = id => /^m\d+$/.test(id) ? 'maestro' + id.slice(1)
    : { primer: 'primera', globos: 'globero', cien: 'est50' }[id] || id;
  const hechos = {};
  Object.entries(o.facts || {}).forEach(([k, f]) => { hechos[k] = { ok: f.ok || 0, mal: f.bad || 0, racha: f.box || 0, ult: o.lastDay || undefined }; });
  const validas = listaInsignias().map(i => i.id);        // las que ya no existen se omiten
  return Object.assign(e, {
    nombre: o.name || '', avatar: o.avatar || e.avatar, estrellas: o.stars || 0,
    racha: o.streak || 0, ultimoDia: o.lastDay || '',
    tamLetra: [0.9, 1, 1.15, 1.3][o.font] || 1, sonido: o.sound !== false, voz: !!o.autoVoice,
    hechos: unirGemelas(hechos),
    metodosVistos: [...new Set((o.methods || []).map(metodo))], metodosResueltos: [...new Set((o.exDone || []).map(metodo))],
    insignias: [...new Set((o.badges || []).map(medalla))].filter(id => validas.includes(id)),
    refuerzo: o.focus || [], tablasJuego: o.gt && o.gt.length ? o.gt : e.tablasJuego,
    sesiones: (o.games && o.games.practices) || 0,
    records: Object.assign(e.records, { carrera: (o.best && o.best.race) || 0 }),
    ultCfg: Object.assign(e.ultCfg, o.ps ? { tablas: o.ps.tables || e.ultCfg.tablas, modo: o.ps.mode || 'opciones', nivel: o.ps.level || 'facil' } : {})
  });
}
function estadoInicial() {
  return {
    nombre: '', avatar: '🦊', estrellas: 0, racha: 0, ultimoDia: '',
    hechos: {},              // "3x7": { ok, mal, racha, ult }  (vale también para 7 × 3; racha = aciertos seguidos, ult = último día)
    metodosVistos: [], metodosResueltos: [], insignias: [],
    tamLetra: 1, sonido: true, voz: false,
    refuerzo: [],            // tablas que pidió reforzar el adulto
    records: { carrera: 0, vf: 0, memorama: 0, globos: 0 },
    ultCfg: { tablas: [2, 5, 10], modo: 'opciones', nivel: 'facil', total: 10 },
    tablasJuego: [2, 3, 4, 5],
    sesiones: 0,
    repasos: 0,              // Repasos de Teco terminados
    lecciones: [],           // tablas con la lección guiada terminada
    ejerciciosMundo: [],     // ejercicios distintos resueltos en Métodos ("ruso:11x6")
    divisiones: 0,           // prácticas de divisiones terminadas (sección Más operaciones)
    patrones: [],            // patrones descubiertos en el Tablero de patrones
    ops: {},                 // sumas, restas y quebrados: { suma: { ok, mal, ses, mejorNivel } }
    fig: { actual: null, avance: {}, hechas: [] }   // Mis dibujos: figura actual, cuadritos pintados y figuras completas
  };
}
function cargar() {
  try {
    const t = localStorage.getItem(CLAVE);
    if (t) {
      const d = JSON.parse(t), base = estadoInicial();
      const e = Object.assign(base, d);
      e.records = Object.assign(estadoInicial().records, d.records || {});
      e.ultCfg = Object.assign(estadoInicial().ultCfg, d.ultCfg || {});
      e.hechos = unirGemelas(e.hechos || {});
      return e;
    }
    const vieja = localStorage.getItem(CLAVE_ANTERIOR);
    if (vieja) return desdeVersionAnterior(JSON.parse(vieja));
  } catch (e) { /* almacenamiento bloqueado: se usa memoria */ }
  return estadoInicial();
}
function guardar() { try { localStorage.setItem(CLAVE, JSON.stringify(E)); } catch (e) { /* sin guardado, la app sigue */ } }
let E = cargar();

/* ---- Hechos de multiplicación y dominio ---- */
const dominado = h => !!h && h.racha >= 3;           // 3 aciertos seguidos = dominada
function registrar(a, b, ok) {
  const k = claveHecho(a, b);
  const h = E.hechos[k] || (E.hechos[k] = { ok: 0, mal: 0, racha: 0 });
  if (ok) { h.ok++; h.racha++; } else { h.mal++; h.racha = 0; }
  h.ult = hoy();
  marcarDia();
  if (ok) pintarPieza(a, b);
  guardar();
  revisarInsignias();
}
function estadoTabla(t) {
  let dom = 0, intentos = 0, ok = 0, vistas = 0;
  for (let n = 1; n <= 12; n++) {
    const h = E.hechos[claveHecho(t, n)];
    if (h) { vistas++; intentos += h.ok + h.mal; ok += h.ok; if (dominado(h)) dom++; }
  }
  // "En camino" pide al menos 3 multiplicaciones vistas: si no, practicar la tabla
  // del 3 pondría en amarillo todas las demás solo por sus gemelas.
  const nivel = dom >= 10 ? 'verde' : vistas >= 3 ? 'amarillo' : 'rojo';
  return { dom, intentos, ok, nivel };
}
const contarDominadas = () => Object.values(E.hechos).filter(h => dominado(h)).length;
/* ---- Repaso de Teco: lo fallado se guarda aunque se cierre la app ----
   "Por dominar": se ha fallado y aún no tiene 3 aciertos seguidos.
   "Para refrescar": ya estaba dominada, pero lleva días sin practicarse. */
const DIAS_REFRESCO = 7;
const diasDesde = f => Math.round((new Date(hoy()) - new Date(f)) / 864e5);
function hechosConDatos() {
  return Object.entries(E.hechos).map(([k, h]) => { const [a, b] = k.split('x').map(Number); return { a, b, h }; });
}
function porDominar() {
  return hechosConDatos().filter(x => x.h.mal > 0 && !dominado(x.h))
    .sort((x, y) => (x.h.racha - y.h.racha) || (y.h.mal - x.h.mal));
}
function porRefrescar() {
  return hechosConDatos().filter(x => dominado(x.h) && x.h.ult && diasDesde(x.h.ult) >= DIAS_REFRESCO)
    .sort((x, y) => diasDesde(y.h.ult) - diasDesde(x.h.ult));
}
function listaRepaso(max) {
  return porDominar().concat(porRefrescar()).slice(0, max).map(x => [x.a, x.b]);
}
const totalRepaso = () => porDominar().length + porRefrescar().length;
const SEMAFORO = {
  rojo: { ico: '🔴', txt: 'Por aprender' },
  amarillo: { ico: '🟡', txt: 'En camino' },
  verde: { ico: '🟢', txt: 'Dominada' }
};

/* ---- Racha de días ---- */
function marcarDia() {
  const d = hoy();
  if (E.ultimoDia === d) return;
  E.racha = (E.ultimoDia === ayer()) ? E.racha + 1 : 1;
  E.ultimoDia = d;
}
const rachaVisible = () => (E.ultimoDia === hoy() || E.ultimoDia === ayer()) ? E.racha : 0;

/* ---- Estrellas ---- */
function ganarEstrellas(n) {
  if (n <= 0) return;
  E.estrellas += n; guardar(); actualizarCabecera(true); revisarInsignias();
}

/* =====================================================================
   3. INSIGNIAS
   ===================================================================== */
function listaInsignias() {
  const base = [
    { id: 'primera', ico: '⭐', nombre: 'Primera estrella', desc: 'Gana tu primera estrella', ok: () => E.estrellas >= 1 },
    { id: 'est50', ico: '🌟', nombre: 'Junta estrellas', desc: 'Junta 50 estrellas', ok: () => E.estrellas >= 50 },
    { id: 'est200', ico: '🌠', nombre: 'Lluvia de estrellas', desc: 'Junta 200 estrellas', ok: () => E.estrellas >= 200 },
    { id: 'racha3', ico: '🔥', nombre: 'Racha de 3 días', desc: 'Practica 3 días seguidos', ok: () => E.racha >= 3 },
    { id: 'racha7', ico: '🏆', nombre: 'Semana completa', desc: 'Practica 7 días seguidos', ok: () => E.racha >= 7 },
    { id: 'explorador', ico: '🌎', nombre: 'Explorador del mundo', desc: 'Mira los 9 métodos del mundo', ok: () => E.metodosVistos.length >= METODOS.length },
